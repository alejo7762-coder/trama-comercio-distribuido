# Copia a .env y reemplaza todos los valores sensibles. Nunca subas .env a Git.
# SQL Server
DB_SERVER=localhost
DB_NAME=TramaDB
DB_TRUSTED_CONNECTION=no
DB_USER=sa
DB_PASSWORD=CAMBIAR_POR_UNA_CLAVE_REAL
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=yes
DB_LOGIN_TIMEOUT=5

# Seguridad: genera un secreto aleatorio largo (por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
JWT_ACCESS_MINUTES=30

# Correo SMTP (sin configurar, el pedido se registra pero no se envía correo)
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
