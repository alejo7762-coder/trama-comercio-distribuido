# Copia este archivo como .env y completa con tus datos reales.
# NUNCA subas el archivo .env real a GitHub (ya está en .gitignore).

# --- Conexión a SQL Server ---
# Instancia por defecto:        localhost
# SQL Server Express (nombrada): localhost\SQLEXPRESS
DB_SERVER=localhost
DB_NAME=TramaDB

# Autenticación de Windows: pon DB_TRUSTED_CONNECTION=yes y deja DB_USER/DB_PASSWORD sin usar.
# Autenticación SQL (usuario y contraseña): pon DB_TRUSTED_CONNECTION=no y completa ambos.
DB_TRUSTED_CONNECTION=no
DB_USER=sa
DB_PASSWORD=CambiaEstaClave

# Nombre EXACTO del driver instalado. Para verlo ejecuta: python scripts/check_env.py
DB_DRIVER=ODBC Driver 18 for SQL Server

# Solo desarrollo local: acepta el certificado autofirmado de SQL Server.
# En un servidor real debe ser "no" y usar un certificado válido.
DB_TRUST_SERVER_CERTIFICATE=yes

# Segundos de espera al conectar antes de fallar.
DB_LOGIN_TIMEOUT=5
